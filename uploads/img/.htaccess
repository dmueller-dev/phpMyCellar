# Disable directory browsing and CGI execution
Options -Indexes -ExecCGI

# Disable PHP engine if mod_php is loaded
<IfModule mod_php7.c>
    php_flag engine off
</IfModule>
<IfModule mod_php8.c>
    php_flag engine off
</IfModule>
<IfModule mod_php.c>
    php_flag engine off
</IfModule>

# Block all script extensions from being executed or accessed directly
<FilesMatch "(?i)\.(php|phtml|php3|php4|php5|php7|php8|phar|shtml|cgi|pl|py|sh|bash|exe|asp|aspx|jsp)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# Strip script MIME types and handlers in this directory
<IfModule mod_mime.c>
    RemoveHandler .php .phtml .php3 .php4 .php5 .php7 .php8 .phar .shtml .cgi .pl .py .sh
    RemoveType .php .phtml .php3 .php4 .php5 .php7 .php8 .phar .shtml .cgi .pl .py .sh
</IfModule>
