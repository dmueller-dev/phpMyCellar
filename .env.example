# ==============================================================================
# phpMyCellar Environment Configuration
# ==============================================================================
# Copy this file to '.env' and adjust the configuration parameters below
# to match your web server and MySQL database environment.
# ==============================================================================

# Database Connection Settings
DB_HOST=localhost
DB_NAME=phpmycellar
DB_USER=cellar_user
DB_PASS=your_secure_password_here

# Application Base Settings
APP_ENV=production
APP_URL=https://your-domain.com

# System Notifications & Mail Sender
MAIL_FROM=cellar@your-domain.com
